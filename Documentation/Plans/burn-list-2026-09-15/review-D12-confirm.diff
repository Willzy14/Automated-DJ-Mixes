+def _pinned_swap_event(out_bass: list[tuple[float, float]],
+                       ov_start: float, ov_end: float,
+                       clips: list[dict], origin: float,
+                       src_lo: float, src_hi: float) -> tuple[float, float] | None:
+    """The (arrangement beat, source beat) of the point `_find_bass_swap_beat`
+    picks for the outgoing, reproduced step for step: `_scope_points`' +-40
+    arrangement-beat pre-filter, the source mapping, then the first point
+    below 0.8 inside the source window. `bass_swap_delta` is built from that
+    source beat; this keeps hold of the arrangement beat it came from so the
+    reliability flag judges the SAME event (review, 2026-09-15)."""
+    for t, v in out_bass:
+        if not (ov_start - GEOMETRY_SWAP_MARGIN_BEATS <= t <= ov_end + GEOMETRY_SWAP_MARGIN_BEATS):
+            continue
+        s = _source_beat(t, clips, origin)
+        if s < src_lo - 10 or s > src_hi + 10:
+            continue
+        if v < 0.8:
+            return t, s
+    return None
+
