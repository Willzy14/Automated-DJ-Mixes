+def _delta_event_reliable(pinned: tuple[float, float] | None,
+                          true_kill_arr: float | None,
+                          true_kill_on_loop: bool) -> bool:
+    """`bass_swap_delta` for one side can be trusted only when the source-
+    space finder selected the outgoing's real first kill (the same event the
+    geometry layer sees in playback order) and that kill sits on a section
+    clip, not a loop clip."""
+    if pinned is None or true_kill_arr is None or true_kill_on_loop:
+        return False
+    return abs(pinned[0] - true_kill_arr) <= 1.0
