2160:def _grid_fold_median(path: Path, t0_sec: float, dur_sec: float,
2161:                      tempo_map: TempoMap) -> float:
2162:    """Lazy librosa: load mono at 22050, lowpass 150 Hz, fold onsets, return
2163:    median phase in ms."""
2164:    import librosa
2165:    dur = min(dur_sec, GRID_FOLD_PROBE_S)
2166:    y, sr = librosa.load(str(path), sr=22050, mono=True,
2167:                         offset=t0_sec, duration=dur)
2168:    sos = butter(4, 150.0, btype="low", fs=sr, output="sos")
2169:    y_low = sosfiltfilt(sos, y)
2170:    env = librosa.onset.onset_strength(y=np.ascontiguousarray(y_low), sr=sr)
2171:    on = librosa.onset.onset_detect(onset_envelope=env, sr=sr, units="time",
2172:                                    backtrack=False)
2173:    if len(on) < 5:
2174:        return 0.0
2175:    times = on + t0_sec
2176:    onset_beats = sec_to_arr(times, tempo_map)
2177:    beat_dur = 60.0 / tempo_map.bpm_at(float(onset_beats.mean()))
2178:    phase_ms = ((onset_beats + 0.5) % 1.0 - 0.5) * beat_dur * 1000.0
2179:    # Dominant-cluster median, not the raw median: solo house program has
2180:    # offbeat percussion whose onsets fold to +/-half-beat and drag the raw
2181:    # median tens of ms off (V10 region at 7:13 reads -31.9 raw vs +49.6
2182:    # clustered while its neighbours cluster at +47.9/+50.9 -- the cluster
2183:    # is the kick lattice, the raw median is the hat pattern). Same
2184:    # histogram logic as probe_render_flam.py.
2185:    half_beat_ms = beat_dur * 500.0
2186:    hist, edges = np.histogram(phase_ms, bins=47,
2187:                               range=(-half_beat_ms, half_beat_ms))
2188:    centers = (edges[:-1] + edges[1:]) / 2.0
2189:    mode_c = centers[int(hist.argmax())]
2190:    near = phase_ms[np.abs(phase_ms - mode_c) <= 60.0]
2191:    if len(near) < 5:
2192:        return float(np.median(phase_ms))
2193:    return float(np.median(near))
