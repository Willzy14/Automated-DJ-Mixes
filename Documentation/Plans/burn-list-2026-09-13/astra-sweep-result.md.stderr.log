2134:def _pick_solo_regions(clips: list[dict], tempo_map: TempoMap,
2135:                       targets_pct: list[float]) -> list[tuple[float, float]]:
2136:    """Solo runs (one active clip) >= GRID_FOLD_REGION_S, pick the one nearest
2137:    each target percentage of the arrangement span. Distinct picks only: if
2138:    every run is already chosen for an earlier target, skip the later target.
2139:    Without the dedup, a single eligible solo run masquerades as multiple
2140:    probes and reports zero drift (one region, three identical phase medians)."""
2141:    arr_start, arr_end = clip_arr_span(clips)
2142:    arr_start_sec = arr_to_sec(arr_start, tempo_map)
2143:    arr_dur = arr_to_sec(arr_end, tempo_map) - arr_start_sec
2144:    runs = solo_runs(clips, tempo_map, GRID_FOLD_REGION_S)
2145:    if not runs:
2146:        return []
2147:    out: list[tuple[float, float]] = []
2148:    chosen: set[tuple[float, float]] = set()
2149:    for pct in targets_pct:
2150:        target = arr_start_sec + pct * arr_dur
2151:        remaining = [r for r in runs if r not in chosen]
2152:        if not remaining:
2153:            continue
2154:        best = min(remaining, key=lambda r: abs(((r[0] + r[1]) / 2) - target))
2155:        out.append(best)
2156:        chosen.add(best)
2157:    return out
