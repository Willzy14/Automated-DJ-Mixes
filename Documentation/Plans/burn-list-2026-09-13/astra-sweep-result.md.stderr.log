        print(f"Project BPM (mode, {most_common[1]} tracks): {project_bpm}")
    else:
        # No mode â€” use median
        sorted_bpms = sorted(rounded_bpms)
        project_bpm = sorted_bpms[len(sorted_bpms) // 2]
