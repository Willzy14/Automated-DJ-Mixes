-                  f"status={a.get('status')}")
+            print(f"    after:  loop_source={a.get('loop_source')} "
+                  f"target={a.get('target_marker_name')} reps={a.get('reps')} "
+                  f"status={a.get('status')} "
+                  f"reason={a.get('outgoing_loop_not_needed')}")
         print()
     return 0
 

