 799: def report_landmark_candidates(
 800:     outgoing: Track,
 801:     incoming: Track,
 802:     alignment: Alignment,
 900:     own field comment); landmark_candidates' start_beat/end_beat are
 901:     already in beats, so this is bar*4.0, not a straight add.
 902:     """
 903:     result: dict = {"outgoing": [], "incoming": []}
 904:     for role, track, track_start in (
 905:         ("outgoing", outgoing, outgoing_start_beat),
 906:         ("incoming", incoming, incoming_start_beat),
 907:     ):
 908:         for start_bar, end_bar in track.vocal_regions:
 909:             absolute_start = track_start + float(start_bar) * 4.0
 910:             absolute_end = track_start + float(end_bar) * 4.0
 911:             result[role].append((round(absolute_start, 3), round(absolute_end, 3)))
 912:     return result
