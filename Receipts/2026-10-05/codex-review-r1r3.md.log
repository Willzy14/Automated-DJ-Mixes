1148: PHRASE_BACKSTEP_BARS = 16
1149: #: An intro is "deep" when its first usable anchor is further in than this.
1150: DEEP_INTRO_BARS = 32
1151: 
1152: 
1153: def _deep_intro_anchor(track: Track) -> int | None:
1154:     """A computed anchor one phrase before a long intro's first real cue.
1155: 
1156:     Sam, 2026-08-17, on a track whose first 48 bars carry no detected marker:
1157:     "at 1:04 it has some hi-hats that come in, that would be a good mix point...
1158:     we can use the same theory we used for the start and end anchors Ã¢â‚¬â€ counting
1159:     back 30 seconds from the first break gets you to that mix point. So if there
1160:     is a huge intro with no cue points, find the first cue point and count back
1161:     from there."
1162: 
1163:     Worked case, Andrea Oliva feat. Morchebba (120 BPM, 2.0 s/bar): first cue at
1164:     bar 48 = 1:36; one phrase back is bar 32 = 1:04 Ã¢â‚¬â€ exactly where he hears the
1165:     hats enter. The detector sees nothing there, so this anchor is COMPUTED, the
1166:     same way the outgoing tail fallback is, and for the same reason: the music
1167:     has a usable entry the analysis layer did not mark.
1168: 
1169:     Without it such a track is not merely awkward but unmixable: with a first
1170:     anchor at bar 48 every overlap is >= 48 bars, and it only equals 48 at the
1171:     outgoing's own end where progress is 1.0 and always rejected. Measured on the
1172:     14.08.26 corpus: 0 of 19 tracks could mix into Morchebba.
1173: 
1174:     Returns None when the intro is not deep, so normal tracks are untouched.
1175:     """
1176:     real = _incoming_phrase_anchors(track) or _incoming_drop_anchors(track)
1177:     if not real:
1178:         return None
1179:     first = min(real)
1180:     if first <= DEEP_INTRO_BARS:
1181:         return None
1182:     candidate = first - PHRASE_BACKSTEP_BARS
1183:     if candidate < PHRASE_BACKSTEP_BARS:
1184:         # Too close to the head to leave the incoming any establishing bars.
1185:         return None
1186:     # Prefer a real marker within a phrase of the computed point, exactly as the
1187:     # outgoing tail rule does Ã¢â‚¬â€ Sam: "there might be a kick dropout or a fill even
1188:     # if the bass stays in, that is still a marker and would probably line up."
1189:     cues = _mix_cues(track)
1190:     near = [bar for bar in cues
1191:             if abs(bar - candidate) <= PHRASE_ANCHOR_TOL and 0 < bar < first]
1192:     if near:
1193:         return min(near, key=lambda bar: (abs(bar - candidate), bar))
1194:     return int(candidate)
